NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:3000
API_URL=http://localhost:5000

# Microsoft SQL Server
DATABASE_URL="sqlserver://localhost:1433;database=qubrid_evalops;user=sa;password=YourStrongPassword123!;encrypt=true;trustServerCertificate=true;connectionLimit=5;poolTimeout=20"

# Redis
REDIS_URL=redis://localhost:6379

# Auth
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN_SECONDS=604800

# Qubrid
QUBRID_BASE_URL=https://platform.qubrid.com/v1
QUBRID_API_KEY=replace-me
QUBRID_DEFAULT_MODEL=openai/gpt-oss-120b
QUBRID_INPUT_COST_PER_MILLION=0
QUBRID_CACHED_INPUT_COST_PER_MILLION=0
QUBRID_OUTPUT_COST_PER_MILLION=0

NEXT_PUBLIC_API_URL=http://localhost:5000

# LLM cache
CACHE_ENABLED=true
CACHE_TTL_SECONDS=3600
CACHE_MAX_ENTRIES_PER_PROJECT=10000

# Optional LLM judge
EVAL_JUDGE_MODEL=openai/gpt-oss-120b

# GitHub Action callback
GITHUB_WEBHOOK_SECRET=replace-me
