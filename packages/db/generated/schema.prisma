generator client {
  provider      = "prisma-client-js"
  output        = "../../../packages/db/generated"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  projects     Project[]
}

model Project {
  id                        String              @id @default(cuid())
  userId                    String
  name                      String
  description               String?
  model                     String
  systemPrompt              String?
  temperature               Float?
  topP                      Float?
  maxTokens                 Int?
  inputCostPerMillion       Float               @default(0)
  cachedInputCostPerMillion Float               @default(0)
  outputCostPerMillion      Float               @default(0)
  allowedQualityDrop        Float               @default(2)
  cacheEnabled              Boolean             @default(true)
  cacheTtlSeconds           Int                 @default(3600)
  createdAt                 DateTime            @default(now())
  updatedAt                 DateTime            @updatedAt
  baseline                  Baseline?
  datasets                  Dataset[]
  evaluators                Evaluator[]
  experiments               Experiment[]
  githubIntegrations        GithubIntegration[]
  user                      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  ciToken                   ProjectCiToken?
}

model Dataset {
  id          String       @id @default(cuid())
  projectId   String
  name        String
  description String?
  version     Int          @default(1)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  experiments Experiment[]
  testCases   TestCase[]
}

model TestCase {
  id             String             @id @default(cuid())
  datasetId      String
  input          String
  expectedOutput String?
  metadata       String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  results        EvaluationResult[]
  dataset        Dataset            @relation(fields: [datasetId], references: [id], onDelete: Cascade)
}

model Evaluator {
  id        String   @id @default(cuid())
  projectId String
  name      String
  type      String
  config    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Experiment {
  id                    String             @id @default(cuid())
  projectId             String
  datasetId             String
  name                  String
  model                 String
  status                String             @default("QUEUED")
  qualityScore          Float?
  passRate              Float?
  avgLatencyMs          Float?
  totalTokens           Int                @default(0)
  totalCostUsd          Float              @default(0)
  cacheHitRate          Float              @default(0)
  cacheMissRate         Float              @default(0)
  llmCallsAvoided       Int                @default(0)
  cachedInputTokens     Int                @default(0)
  estimatedCostSavedUsd Float              @default(0)
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  allowedQualityDrop    Float              @default(2)
  errorMessage          String?
  failOnRegression      Boolean            @default(true)
  regressionDelta       Float?
  regressionPassed      Boolean            @default(true)
  useCache              Boolean            @default(true)
  results               EvaluationResult[]
  dataset               Dataset            @relation(fields: [datasetId], references: [id], onUpdate: NoAction)
  project               Project            @relation(fields: [projectId], references: [id], onUpdate: NoAction)
}

model EvaluationResult {
  id                       String     @id @default(cuid())
  experimentId             String
  testCaseId               String
  actualOutput             String
  score                    Float
  passed                   Boolean
  latencyMs                Int?
  ttftMs                   Int?
  inputTokens              Int?
  outputTokens             Int?
  cacheHit                 Boolean    @default(false)
  reason                   String?
  evaluatorResults         String?
  createdAt                DateTime   @default(now())
  cachedInputTokens        Int        @default(0)
  estimatedCostUsd         Float?
  totalTokens              Int?
  uncachedEstimatedCostUsd Float?
  experiment               Experiment @relation(fields: [experimentId], references: [id], onUpdate: NoAction)
  testCase                 TestCase   @relation(fields: [testCaseId], references: [id], onUpdate: NoAction)
}

model GithubIntegration {
  id             String   @id @default(cuid())
  projectId      String
  repositoryName String
  repositoryId   String?
  installationId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Baseline {
  id           String   @id @default(cuid())
  projectId    String   @unique
  experimentId String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model ProjectCiToken {
  id          String    @id @default(cuid())
  projectId   String    @unique
  tokenHash   String    @unique
  tokenPrefix String
  createdAt   DateTime  @default(now())
  revokedAt   DateTime?
  project     Project   @relation(fields: [projectId], references: [id], onUpdate: NoAction)
}
